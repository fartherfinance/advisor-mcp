# advisor-mcp configuration.
# Copy this file to .env (which is git-ignored) and adjust as needed.
#
# By default the server reuses your Claude Max subscription token that Claude
# Code already stores in ~/.claude/.credentials.json, so you normally do NOT
# need to set any credential value here.

# Advisor model to query.
ADVISOR_MODEL=claude-fable-5

# Default cap on the advisor's response length.
ADVISOR_MAX_TOKENS=128000

# Request timeout in seconds.
ADVISOR_TIMEOUT=120

# --- Credential source (optional overrides) ---

# Path to the Claude Code credentials file. Defaults to
# ~/.claude/.credentials.json if unset.
# ADVISOR_CREDENTIALS_PATH=C:\Users\mesol\.claude\.credentials.json

# Explicit OAuth access token override. If set, the credentials file is ignored.
# Leave unset to reuse the Claude Max subscription automatically.
# ANTHROPIC_OAUTH_TOKEN=
